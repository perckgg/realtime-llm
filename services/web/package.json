{
  "name": "aiops-rca-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Dashboard 4 màn hình cho AIOps RCA Platform (Giai đoạn 2). Chỉ đọc.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc -b --noEmit",
    "smoke": "vite build --ssr scripts/smoke.tsx --outDir dist-smoke --logLevel error && node dist-smoke/smoke.js",
    "check": "npm run lint && npm run smoke"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  }
}
