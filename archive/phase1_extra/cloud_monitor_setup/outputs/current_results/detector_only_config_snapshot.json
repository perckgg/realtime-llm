{
  "experiment": {
    "name": "microsoft_cloud_monitoring_dataset_current",
    "mode": "detector_only"
  },
  "data": {
    "metric_path": "cloud_monitor_setup/processed/metrics.csv",
    "log_path": "cloud_monitor_setup/processed/logs.jsonl"
  },
  "preprocessing": {
    "window_size": 3600,
    "stride": 3600,
    "normalization": "zscore"
  },
  "detector": {
    "name": "feature_pressure",
    "contamination": 0.05,
    "threshold": 0.85
  },
  "retrieval": {
    "vector_db": "local",
    "embedding_model": "hashing",
    "top_k": 5,
    "time_margin_minutes": 1000000
  },
  "llm_gate": {
    "enabled": true,
    "low_threshold": 0.65,
    "high_threshold": 0.95,
    "high_score_action": "direct_alert",
    "max_llm_calls_per_minute": 0
  },
  "llm": {
    "provider": "mock",
    "model": "mock-judge",
    "temperature": 0,
    "max_output_tokens": 512
  },
  "decision": {
    "confidence_threshold": 0.8,
    "llm_budget_exhausted_action": "manual_review"
  },
  "evaluation": {
    "output_dir": "cloud_monitor_setup/outputs/current_results",
    "audit_dir": "cloud_monitor_setup/outputs/current_audit"
  }
}